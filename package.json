  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "session",
    "rename"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "config.ts",
    "state.ts",
    "naming.ts",
    "ui-config.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*"
  }
}
