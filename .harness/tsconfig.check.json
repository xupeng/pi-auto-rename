{
  // Typecheck harness. The @earendil-works declarations are resolved from a
  // locally readable runtime (pi-web, Pi 1.0.0) because the previous
  // version-pinned pnpm store paths no longer exist on this machine. The
  // extension still advertises pi >= 0.84: every API used here
  // (modelRegistry.complete, session_shutdown, session_before_tree, session_tree,
  // sessionManager.getSessionId/getLeafId) is present in 0.84.0. Repoint these
  // paths if the local checkout moves.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "typeRoots": ["/home/xupeng/services/pi-web/dist/node_modules/@types"],
    "paths": {
      "@earendil-works/pi-coding-agent": [
        "/home/xupeng/services/pi-web/dist/node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"
      ],
      "@earendil-works/pi-ai": [
        "/home/xupeng/services/pi-web/dist/node_modules/@earendil-works/pi-ai/dist/index.d.ts"
      ],
      "@earendil-works/pi-ai/compat": [
        "/home/xupeng/services/pi-web/dist/node_modules/@earendil-works/pi-ai/dist/compat.d.ts"
      ],
      "@earendil-works/pi-tui": [
        "/home/xupeng/services/pi-web/dist/node_modules/@earendil-works/pi-tui/dist/index.d.ts"
      ]
    }
  },
  "include": ["../index.ts", "../config.ts", "../state.ts", "../naming.ts", "../ui-config.ts"]
}
